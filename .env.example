# ===================================================================
# Smart Manufacturing Order Processing System - Environment Variables
# ===================================================================

# Application Server Port
PORT=8081

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_manufacturing_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Active Spring Profile (default for H2 embedded zero-config, mysql for MySQL 8)
SPRING_PROFILES_ACTIVE=default
